{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tug",
  "version": "1.0.0",
  "identifier": "com.tug.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tug",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Tug",
    "copyright": "Copyright © 2026 Tug contributors",
    "shortDescription": "多协议下载器",
    "longDescription": "Tug 是支持 HTTP/HTTPS、BitTorrent 与磁力链接的 Windows 桌面下载器。",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
